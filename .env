# port
VITE_PORT = 8000

# spa-title
VITE_GLOB_APP_TITLE = 'wx-zan'

# 系统中文名称
VITE_GLOB_APP_TITLE_CN = '微信'

# spa shortname 不可出现空格数字等特殊字符
VITE_GLOB_APP_SHORT_NAME = vantMobile

# 生产环境 开启mock
VITE_GLOB_PROD_MOCK = true

# IndexDB 数据库名称
VITE_GLOB_INDEXDB_NAME = 'wx_zan'

# IndexDB 存储表名
VITE_GLOB_INDEXDB_STORE = 'my_circle_friend_store'


